# panda-invoice-download settings. Copy to .env (or e.g. /etc/panda-invoice-download/panda.env),
# fill in, and keep it private: chmod 600. Never commit the real file.

# Panda customer portal login (https://my.panda.ie)
PANDA_EMAIL=you@example.com
PANDA_PASSWORD=change-me

# Paperless-ngx base URL and API token (Profile -> API Auth Token in the Paperless web UI)
PAPERLESS_URL=http://paperless.example.lan:8000
PAPERLESS_TOKEN=0123456789abcdef0123456789abcdef01234567

# Optional: only consider invoices dated on or after this day (YYYY-MM-DD). Empty = all.
SINCE=

# Optional: the portal can be slow. Seconds per request, and attempts per request.
HTTP_TIMEOUT=120
HTTP_RETRIES=3

# Optional: where the last_success stamp is written.
STATE_DIR=/var/lib/panda-invoice-download

# Optional: URL that receives a JSON POST {"source": ..., "message": ...} when a run fails.
ALERT_WEBHOOK=
