[Unit]
Description=Download new Panda waste invoices into Paperless-ngx
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/panda-invoice-download/.venv/bin/python /opt/panda-invoice-download/panda_invoice_download.py --env-file /etc/panda-invoice-download/panda.env
TimeoutStartSec=30min
StateDirectory=panda-invoice-download
